{
  "expo": {
    "name": "Smart Checkout",
    "slug": "smart-checkout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F9FC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartcheckout.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Smart Checkout needs camera access to scan product barcodes."
      }
    },
    "android": {
      "package": "com.smartcheckout.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F9FC"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Smart Checkout",
      "shortName": "SmartCheckout",
      "description": "Scan products, manage your cart, and pay — all from one app."
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Smart Checkout needs camera access to scan product barcodes."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "f3099939-3bb5-48b2-91c0-3d7cab9b1a5b"
      }
    }
  }
}
