EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# If your backend uses a different local port, set it here.
# Example: EXPO_PUBLIC_API_BASE_URL=http://localhost:3003

# For Vercel web deployment, set this environment variable to the API function path:
# EXPO_PUBLIC_API_BASE_URL=/api
# If your backend starts on another port, update this value accordingly.
# Example: EXPO_PUBLIC_API_BASE_URL=http://localhost:3003/api
